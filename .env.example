# --- Ollama (endpoint kompatibel OpenAI) ---
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1

# Nama harus sama persis dengan output `ollama list`
OPENAI_MODEL=qwen3.8:27b
# Model untuk intent classifier. Boleh model yang lebih kecil agar lebih cepat.
OPENAI_MODEL_FAST=qwen3.8:27b

# Matikan thinking mode model Qwen3 (none | low | medium | high). Kosongkan untuk tidak mengirim parameter ini.
LLM_REASONING_EFFORT=none

# Model embedding di Ollama (ollama pull bge-m3:567m)
EMBEDDING_MODEL=bge-m3:567m

# --- Jika memakai OpenAI asli: hapus OPENAI_BASE_URL, kosongkan LLM_REASONING_EFFORT,
#     dan set EMBEDDING_MODEL=text-embedding-3-small ---
